(version 1)


(rule "Pad to Silkscreen"
	(layer outer)
	(condition "A.Type == 'Pad' && B.Layer == '?.Silkscreen'")
	(constraint silk_clearance (min 0.15mm))
)

# Castellated pads intentionally touch the board edge.
(rule "Allow Castellated Pads On Board Edge"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad' && B.Layer == 'Edge.Cuts'")
	(constraint edge_clearance (min -1mm))
)

(rule "Castellated Hole Diameter"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad'")
	(constraint hole_size (min 0.5mm))
)

(rule "Castellated Hole To Hole Clearance"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad' && B.Fabrication_Property == 'Castellated pad'")
	(constraint hole_to_hole (min 0.5mm))
)

(rule "Castellated Annular Ring"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad'")
	(constraint annular_width (min 0.25mm))
)

(rule "Plated Slot Width"
	(condition "A.Pad_Type == 'Through-hole' && A.Hole_Shape == 'Oval'")
	(constraint hole_size (min 0.5mm) (max 6.3mm))
)

(rule "Non-Plated Round Hole Diameter"
	(condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Shape == 'Round'")
	(constraint hole_size (min 0.5mm) (max 6.3mm))
)

(rule "Non-Plated Slot Width"
	(condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Shape == 'Oval'")
	(constraint hole_size (min 1.0mm) (max 6.3mm))
)

(rule "PTH Component Pad Annular Ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Fabrication_Property != 'Castellated pad'")
	(constraint annular_width (min 0.15mm))
)

# --- Component Pad Annular Ring Overrides ---
# These rules intercept component pads and enforce JLCPCB's structural minimums.
# This prevents the global via constraints (e.g., 0.05 mm) from compromising assembly yield.

(rule "PTH Component Pad Annular Ring"
	(condition "A.Type == 'pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm))
)

(rule "NPTH Mechanical Pad Annular Ring"
	(condition "A.Type == 'pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint annular_width (min 0.45mm))
)

